{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet sln list:*)",
      "Bash(dotnet list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet restore:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet --list-sdks)",
      "PowerShell(dotnet sln list:*)",
      "PowerShell(dotnet list:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git branch:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)"
    ],
    "deny": [
      "Read(**/appsettings.Development.json)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)"
    ]
  }
}
