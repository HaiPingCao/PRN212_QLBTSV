<Window x:Class="QLBT.Client.Views.Teacher.GradeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grade" Width="500" Height="440" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Window_Loaded">
    <Grid x:Name="Root" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Student:" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="StudentText" Style="{StaticResource ValueText}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Submitted:" Style="{StaticResource FieldLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SubmittedText" Style="{StaticResource ValueText}" />
            <TextBlock Grid.Row="2" Text="File:" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock x:Name="FileText" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                <Button Content="Download" Style="{StaticResource ToolbarButton}" Click="Download_Click" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Score:" Style="{StaticResource FieldLabel}" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="ScoreBox" Width="70" MaxLength="5" Style="{StaticResource FieldBox}" Margin="0,0,6,6"
                         ToolTip="0 to 10, at most 2 decimals (8.5 or 8,5)" />
                <TextBlock Text="/ 10" Style="{StaticResource FieldLabel}" />
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="Comment" Margin="0,4,0,6">
            <TextBox x:Name="CommentBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="2" />
        </GroupBox>

        <TextBlock Grid.Row="2" x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Save" IsDefault="False" Style="{StaticResource ToolbarButton}" Click="Save_Click" />
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource ToolbarButton}" Margin="0" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Style="{StaticResource FooterText}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>
    </Grid>
</Window>
