<Window x:Class="QLBT.Client.Views.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My profile" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="Window_Loaded">
    <StackPanel Margin="16">
        <GroupBox Style="{StaticResource EditorPanel}">
            <GroupBox.Header>
                <TextBlock Text="Profile" Style="{StaticResource EditorTitle}" />
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Username:" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UsernameText" Style="{StaticResource ValueText}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Text="Full name:" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FullNameText" Style="{StaticResource ValueText}" />
                <TextBlock Grid.Row="2" Text="Email:" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EmailText" Style="{StaticResource ValueText}" />
                <TextBlock Grid.Row="3" Text="Role:" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RoleText" Style="{StaticResource ValueText}" />
            </Grid>
        </GroupBox>
        <TextBlock x:Name="StatusText" Style="{StaticResource FooterText}" Text="Loading..." />
        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Style="{StaticResource ToolbarButton}"
                Margin="0,8,0,0" />
    </StackPanel>
</Window>
