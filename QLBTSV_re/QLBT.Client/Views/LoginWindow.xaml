<Window x:Class="QLBT.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QLBT – Login" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed">
    <StackPanel x:Name="Root" Margin="20">
        <TextBlock Text="QLBT – Assignment manager" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Username:" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="UsernameBox" MaxLength="20" Style="{StaticResource FieldBox}"
                     Margin="0,0,0,8" ToolTip="MSSV / MSGV" />
            <TextBlock Grid.Row="1" Text="Password:" Style="{StaticResource FieldLabel}" />
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Style="{StaticResource FieldBox}" Margin="0,0,0,8" />
        </Grid>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />
        <TextBlock x:Name="ServerText" Foreground="{StaticResource StatusMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                   ToolTip="Set ServerUrl in appsettings.json next to QLBT.Client.exe, then restart" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LoginButton" Content="Login" IsDefault="True" Style="{StaticResource ToolbarButton}" Click="Login_Click" />
            <Button Content="Exit" IsCancel="True" Style="{StaticResource ToolbarButton}" Margin="0" Click="Exit_Click" />
        </StackPanel>
    </StackPanel>
</Window>
