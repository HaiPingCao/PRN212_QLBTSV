<UserControl x:Class="QLBT.Server.Views.SemestersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded">
    <Grid x:Name="Root" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Editor -->
        <GroupBox Grid.Row="0" Style="{StaticResource EditorPanel}">
            <GroupBox.Header>
                <TextBlock x:Name="EditorTitle" Style="{StaticResource EditorTitle}" Text="New semester" />
            </GroupBox.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" MaxLength="20" Width="160" HorizontalAlignment="Left"
                             Style="{StaticResource FieldBox}" ToolTip="e.g. FA26" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Start date:" Style="{StaticResource FieldLabel}" />
                    <DatePicker Grid.Row="1" Grid.Column="1" x:Name="StartPicker" Width="160" HorizontalAlignment="Left"
                                Style="{StaticResource FieldBox}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="End date:" Style="{StaticResource FieldLabel}" />
                    <DatePicker Grid.Row="1" Grid.Column="3" x:Name="EndPicker" Width="160" HorizontalAlignment="Left"
                                Style="{StaticResource FieldBox}" />
                </Grid>

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete" Style="{StaticResource ToolbarButton}" Margin="0"
                            Click="Delete_Click" />
                    <Button DockPanel.Dock="Right" Content="+ New" Style="{StaticResource ToolbarButton}" Click="New_Click" />
                    <Button Content="Save" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Click="Save_Click" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="⟳ Refresh" Style="{StaticResource ToolbarButton}" Margin="0" Click="Refresh_Click" />
            <TextBlock Text="Semesters (newest first)" VerticalAlignment="Center" Foreground="{StaticResource StatusMutedBrush}" />
        </DockPanel>

        <!-- List -->
        <DataGrid Grid.Row="2" x:Name="SemestersGrid" SelectionChanged="Grid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="110" />
                <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource StatusMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="NotStarted">
                                    <Setter Property="Foreground" Value="{StaticResource StatusWarnBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Classes" Binding="{Binding ClassCount}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
