<UserControl x:Class="QLBT.Server.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="View_Loaded" PreviewKeyDown="View_PreviewKeyDown">
    <Grid x:Name="Root" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Editor -->
        <GroupBox Grid.Row="0" Style="{StaticResource EditorPanel}">
            <GroupBox.Header>
                <TextBlock x:Name="EditorTitle" Style="{StaticResource EditorTitle}" Text="New user" />
            </GroupBox.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Role:" Style="{StaticResource FieldLabel}" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
                        <RadioButton x:Name="StudentRadio" Content="Student" GroupName="Role" IsChecked="True" Margin="0,0,16,0"
                                     Checked="Field_Changed" />
                        <RadioButton x:Name="TeacherRadio" Content="Teacher" GroupName="Role" Checked="Field_Changed" />
                        <TextBlock x:Name="RoleLockedText" Text="(locked)" Margin="12,0,0,0" Foreground="{StaticResource StatusMutedBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Username:" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="UsernameBox" MaxLength="20" Style="{StaticResource FieldBox}"
                             ToolTip="MSSV / MSGV, used to log in" TextChanged="Field_Changed" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Full name:" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="FullNameBox" MaxLength="100" Style="{StaticResource FieldBox}"
                             TextChanged="Field_Changed" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Email:" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="EmailBox" MaxLength="100" Style="{StaticResource FieldBox}"
                             TextChanged="Field_Changed" />

                    <TextBlock Grid.Row="2" Grid.Column="0" x:Name="PasswordLabel" Text="Password:" Style="{StaticResource FieldLabel}" />
                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Style="{StaticResource FieldBox}"
                                 PasswordChanged="Field_Changed" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Confirm:" Style="{StaticResource FieldLabel}" />
                    <PasswordBox Grid.Row="2" Grid.Column="3" x:Name="ConfirmBox" Style="{StaticResource FieldBox}"
                                 PasswordChanged="Field_Changed" />

                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="PasswordHint" Margin="0,0,0,4"
                               Foreground="{StaticResource StatusMutedBrush}" Text="Leave the password empty to keep the current one." />
                </Grid>

                <TextBlock x:Name="InfoText" Style="{StaticResource InfoText}" Visibility="Collapsed" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

                <DockPanel Margin="0,6,0,0">
                    <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete" Style="{StaticResource ToolbarButton}" Margin="0"
                            Click="Delete_Click" />
                    <Button DockPanel.Dock="Right" Content="+ New" Style="{StaticResource ToolbarButton}"
                            ToolTip="Add a new user (Ctrl+N)" Click="New_Click" />
                    <TextBlock x:Name="DirtyText" DockPanel.Dock="Right" Text="● Unsaved changes" Margin="0,0,12,0"
                               VerticalAlignment="Center" Foreground="{StaticResource StatusWarnBrush}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource ToolbarButton}" IsDefault="False"
                                ToolTip="Save (Ctrl+S)" Click="Save_Click" />
                        <Button Content="Cancel" Style="{StaticResource ToolbarButton}" Click="Cancel_Click" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <!-- Filter row -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="⟳ Refresh" Style="{StaticResource ToolbarButton}" Margin="0"
                    ToolTip="Reload from the database (F5)" Click="Refresh_Click" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Role:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="RoleFilter" Width="110" SelectedIndex="0" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Teachers" />
                    <ComboBoxItem Content="Students" />
                </ComboBox>
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="SearchBox" Width="240" VerticalContentAlignment="Center" TextChanged="Filter_Changed"
                         ToolTip="Username, name or email" />
            </StackPanel>
        </DockPanel>

        <!-- List -->
        <DataGrid Grid.Row="2" x:Name="UsersGrid" SelectionChanged="Grid_SelectionChanged" PreviewKeyDown="Grid_PreviewKeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" />
                <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="2*" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="2*" />
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90" />
                <DataGridTextColumn Header="Classes" Binding="{Binding ClassCount}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" x:Name="FooterText" Style="{StaticResource FooterText}" />
    </Grid>
</UserControl>
