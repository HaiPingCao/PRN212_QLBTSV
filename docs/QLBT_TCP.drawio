    <diagram id="4._Wire_format_&amp;_files" name="4. Wire format &amp; files">
        <mxGraphModel dx="920" dy="559" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1180" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="c3" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" value="What travels on the wire" vertex="1">
                    <mxGeometry height="40" width="900" x="40" y="10" as="geometry"/>
                </mxCell>
                <mxCell id="c4" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;whiteSpace=wrap;" value="Every message: a 4-byte length, the JSON, then file bytes only if FileLength is set." vertex="1">
                    <mxGeometry height="25" width="1000" x="40" y="45" as="geometry"/>
                </mxCell>
                <mxCell id="c5" parent="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;int32 length&lt;/b&gt;&lt;br&gt;4 bytes, little-endian" vertex="1">
                    <mxGeometry height="60" width="200" x="40" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="c6" parent="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;UTF-8 JSON&lt;/b&gt; of Request or Response&lt;br&gt;max 1 MB (Wire.MaxMessageBytes)" vertex="1">
                    <mxGeometry height="60" width="420" x="240" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="c7" parent="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" value="&lt;b&gt;file bytes&lt;/b&gt; (optional)&lt;br&gt;exactly FileLength bytes, no size limit" vertex="1">
                    <mxGeometry height="60" width="380" x="660" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="c8" parent="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Request JSON&lt;/b&gt; &lt;i&gt;client → server&lt;/i&gt;&lt;hr&gt;Type: &quot;SubmitAssignment&quot; (enum as name)&lt;br&gt;SessionId: null before login&lt;br&gt;Body: { ... } operation data, or null&lt;br&gt;FileLength: bytes that follow, or null" vertex="1">
                    <mxGeometry height="100" width="480" x="40" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="c9" parent="1" style="whiteSpace=wrap;html=1;fontSize=11;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;Response JSON&lt;/b&gt; &lt;i&gt;server → client&lt;/i&gt;&lt;hr&gt;Type: same as the request&lt;br&gt;Status: Ok · Unauthorized · Forbidden · Rejected ...&lt;br&gt;Error: message when Status is not Ok&lt;br&gt;SessionId: only set by a successful Login&lt;br&gt;Body · FileLength: same meaning as in Request" vertex="1">
                    <mxGeometry height="115" width="480" x="560" y="180" as="geometry"/>
                </mxCell>
                <mxCell id="c10" parent="1" style="text;html=1;fontSize=14;align=left;" value="&lt;b&gt;Upload&lt;/b&gt; (e.g. SubmitAssignment)" vertex="1">
