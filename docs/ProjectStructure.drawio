        <mxCell id="s_models" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;Models/&lt;/b&gt; scaffolded EF Core (never hand-edit): &lt;b&gt;Prn212PQlbtContext&lt;/b&gt;&lt;br&gt;User · Role · Semester · Course · Class · ClassStudent · Assignment · Submission">
          <mxGeometry x="740" y="590" width="660" height="60" as="geometry"/>
