        <mxCell id="storage" parent="1" vertex="1" style="shape=folder;whiteSpace=wrap;html=1;tabWidth=50;tabHeight=14;tabPosition=left;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;storage/&lt;/b&gt; (StoragePath)&lt;br&gt;{sem}/{class}/{assignment}/assignment&lt;br&gt;.../submissions/{submissionId}">
