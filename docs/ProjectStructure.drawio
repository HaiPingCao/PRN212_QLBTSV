<mxfile host="drawio">
  <diagram id="structure" name="Project structure">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" parent="1" vertex="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" value="QLBTSV – project structure (QLBTSV_re.sln)">
          <mxGeometry x="20" y="0" width="560" height="26" as="geometry"/>
        </mxCell>

        <!-- ============ Containers ============ -->
        <mxCell id="client" parent="1" vertex="1" style="swimlane;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" value="QLBT.Client (WPF, talks to the server only over HTTP)">
          <mxGeometry x="20" y="60" width="360" height="650" as="geometry"/>
        </mxCell>
        <mxCell id="shared" parent="1" vertex="1" style="swimlane;html=1;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;rounded=1;arcSize=4;" value="QLBT.Shared (classlib)">
          <mxGeometry x="420" y="60" width="260" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="server" parent="1" vertex="1" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;rounded=1;arcSize=2;" value="QLBT.Server (WPF admin GUI + in-process ASP.NET Core API)">
          <mxGeometry x="720" y="60" width="700" height="650" as="geometry"/>
        </mxCell>

        <!-- ============ Shared ============ -->
        <mxCell id="sh_files" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#d6b656;" value="&lt;b&gt;ApiRoutes.cs&lt;/b&gt; route constants, ApiJson&lt;br&gt;&lt;b&gt;ApiStatus.cs&lt;/b&gt; Ok / Unauthorized / Forbidden / ...&lt;br&gt;&lt;b&gt;DTOs.cs&lt;/b&gt; request / response DTOs">
          <mxGeometry x="435" y="100" width="230" height="95" as="geometry"/>
        </mxCell>

        <!-- ============ Client ============ -->
        <mxCell id="c_views" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" value="&lt;b&gt;Views/&lt;/b&gt;&lt;br&gt;LoginWindow · ProfileDialog&lt;br&gt;&lt;b&gt;Teacher/&lt;/b&gt;&lt;br&gt;&amp;nbsp; TeacherWindow (classes · assignments · submissions)&lt;br&gt;&amp;nbsp; ClassInfoDialog · GradeDialog · TeacherRows&lt;br&gt;&lt;b&gt;Student/&lt;/b&gt;&lt;br&gt;&amp;nbsp; StudentWindow (tree by class / list by due + detail)&lt;br&gt;&amp;nbsp; StudentRows">
          <mxGeometry x="40" y="100" width="320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="c_app" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" value="&lt;b&gt;App.xaml(.cs)&lt;/b&gt; styles, navigation:&lt;br&gt;Login → Teacher / Student window;&lt;br&gt;Logout / SessionExpired → Login">
          <mxGeometry x="40" y="270" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c_ui" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" value="&lt;b&gt;UiHelper.cs&lt;/b&gt; Check(ApiResult) (Unauthorized → login),&lt;br&gt;file dialogs, BusyScope, formats">
          <mxGeometry x="40" y="360" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c_api" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" value="&lt;b&gt;Api/&lt;/b&gt;&lt;br&gt;&lt;b&gt;QlbtApi&lt;/b&gt; one call per operation&lt;br&gt;&lt;b&gt;ApiClient&lt;/b&gt; HttpClient, Bearer sessionId,&lt;br&gt;&amp;nbsp; JSON, upload / download, never throws&lt;br&gt;&lt;b&gt;Session&lt;/b&gt; current user + ApiClient">
          <mxGeometry x="40" y="440" width="320" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c_settings" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#6c8ebf;" value="&lt;b&gt;ClientSettings.cs&lt;/b&gt; + &lt;b&gt;appsettings.json&lt;/b&gt;&lt;br&gt;{ &quot;ServerUrl&quot;: ... } (no UI to change it)">
          <mxGeometry x="40" y="620" width="320" height="60" as="geometry"/>
        </mxCell>

        <!-- ============ Server: admin GUI (left column) ============ -->
        <mxCell id="s_main" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;b&gt;MainWindow.xaml&lt;/b&gt; tabs: Users · Semesters · Courses ·&lt;br&gt;Classes · Server configuration · Server log">
          <mxGeometry x="740" y="100" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s_views" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;b&gt;Views/&lt;/b&gt; (admin tabs, code-behind)&lt;br&gt;UsersView · SemestersView · CoursesView&lt;br&gt;ClassesView · AddStudentsDialog&lt;br&gt;ViewHelper (messages, DB error dialog)">
          <mxGeometry x="740" y="180" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s_admin" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;b&gt;Admin/&lt;/b&gt; (DB work + rule checks → AdminResult)&lt;br&gt;UserAdminService · SemesterAdminService&lt;br&gt;CourseAdminService · ClassAdminService&lt;br&gt;AdminLog (→ Server log tab) · Rows.cs (grid rows)">
          <mxGeometry x="740" y="300" width="320" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s_dbf" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;b&gt;DAO/&lt;/b&gt; UserDAO, SemesterDAO, CourseDAO, ClassDAO: every admin query;&lt;br&gt;DbFactory.Create(): new context per call, from appsettings.json">
          <mxGeometry x="740" y="420" width="320" height="60" as="geometry"/>
        </mxCell>

        <!-- ============ Server: HTTP API (right column) ============ -->
        <mxCell id="s_asp" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;b&gt;Asp/&lt;/b&gt;&lt;br&gt;ServerHost (DI, Kestrel, AddDbContext)&lt;br&gt;ServerRunner (Start / Stop) · ServerSettings&lt;br&gt;UiLoggerProvider (→ Server log tab)">
