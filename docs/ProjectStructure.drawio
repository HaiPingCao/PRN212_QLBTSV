        <mxCell id="s_end" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;b&gt;Asp/Endpoints/&lt;/b&gt; (Minimal API)&lt;br&gt;AuthEndpoints · TeacherEndpoints&lt;br&gt;StudentEndpoints · SubmissionEndpoints&lt;br&gt;ApiResults (ApiError body)">
          <mxGeometry x="1090" y="200" width="310" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s_auth" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;b&gt;Asp/SessionAndAuthentication/&lt;/b&gt;&lt;br&gt;SessionStore (in memory) · Session&lt;br&gt;SessionAuthenticationHandler (Bearer)&lt;br&gt;Policies · ClaimsPrincipalExtensions">
          <mxGeometry x="1090" y="310" width="310" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s_files" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;b&gt;Files/&lt;/b&gt; FileStorage (id-based paths)&lt;br&gt;FileReceiver (streamed upload → .tmp)">
          <mxGeometry x="1090" y="420" width="310" height="60" as="geometry"/>
        </mxCell>

        <!-- ============ Server: shared by both halves ============ -->
        <mxCell id="s_domain" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#ffffff;strokeColor=#82b366;dashed=1;" value="&lt;b&gt;Domain/&lt;/b&gt; rules used by both endpoints and admin services: AssignmentRules (closed state, submit checks) · SemesterRules · AdminResult">
          <mxGeometry x="740" y="510" width="660" height="50" as="geometry"/>
